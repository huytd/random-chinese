{
  "manifest_version": 3,
  "name": "Random Chinese",
  "short_name": "Random Chinese",
  "version": "0.1.0",
  "description": "Learn Chinese while you browse: swaps a few English words on every page for HSK words at your level. Click one for pinyin, audio and meaning.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Random Chinese",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "tts"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/dict.js", "src/matcher.js", "src/settings.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
